---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import OgCover from '../assets/og-cover.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
const shareImage = image ?? OgCover;
---

<!-- fallbackImage 仅在 image 缺省时生效（主题里是 image ?? fallbackImage），
     这里与主分享图同源，避免多打包一张 1.2MB 的占位图。 -->
<ThemeBaseHead
  title={title}
  description={description}
  image={shareImage}
  fallbackImage={shareImage}
  site={site}
  fonts={fonts}
/>
