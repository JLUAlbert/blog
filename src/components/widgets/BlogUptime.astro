---
import RollingNumber from '../RollingNumber.astro';

// 博客运行时间：大数字「已运行 N 天」置于计时器正上方，时/分/秒以独立计时格实时跳动。
const start = '2026-10-28T16:00:00+08:00';
const startMs = new Date(start).getTime();
const buildDays = Math.max(0, Math.floor((Date.now() - startMs) / 86400000));
---

<section class="glass-card uptime-card" data-uptime data-start={start} aria-label="博客已运行时间">
  <div class="uptime-head">
    <strong class="uptime-label">已运行 · Since Oct 28, 2026</strong>
    <div class="uptime-days">
      <RollingNumber value={buildDays} id="uptime-days-odo" digits={3} />
      <span class="uptime-days-unit">天</span>
    </div>
  </div>

  <div class="uptime-grid">
    <div class="uptime-unit">
      <span class="uptime-num" data-unit="hours">00</span>
      <span class="uptime-unit-label">时</span>
    </div>
    <div class="uptime-unit">
      <span class="uptime-num" data-unit="mins">00</span>
      <span class="uptime-unit-label">分</span>
    </div>
    <div class="uptime-unit">
      <span class="uptime-num" data-unit="secs">00</span>
      <span class="uptime-unit-label">秒</span>
    </div>
  </div>
</section>

<style>
  .uptime-card {
    display: grid;
    gap: 18px;
    padding: 22px 26px 24px;
    max-width: 680px;
  }

  .uptime-label {
    color: var(--paper-accent);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .uptime-days {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 6px;
  }

  .uptime-days :global(.odometer) {
    font-family: var(--font-ui-label);
    font-size: clamp(2.6rem, 8vw, 3.4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--paper-ink);
  }

  .uptime-days-unit {
    color: var(--paper-ink-soft);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .uptime-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .uptime-unit {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 12px 6px;
    border: 1px solid var(--paper-line);
    border-radius: 10px;
    background: var(--paper-surface);
  }

  .uptime-num {
    font-family: var(--font-ui-label);
    font-size: clamp(1.25rem, 3.2vw, 1.65rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--paper-ink);
  }

  .uptime-unit-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--paper-ink-soft);
  }

  @media (max-width: 480px) {
    .uptime-grid {
      gap: 8px;
    }

    .uptime-unit {
      padding: 10px 4px;
    }
  }
</style>

<script>
  import { getOdometer, mountOdometerOn } from '../../scripts/odometer';

  const initUptime = () => {
    const card = document.querySelector<HTMLElement>('[data-uptime]');
    if (!card) return;

    const start = new Date(card.dataset.start ?? '').getTime();
    if (Number.isNaN(start)) return;

    const nums: Record<string, HTMLElement | null> = {};
    card.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
      nums[el.dataset.unit ?? ''] = el;
    });

    const daysEl = document.getElementById('uptime-days-odo');
    let daysOdo = daysEl ? (getOdometer(daysEl) ?? mountOdometerOn(daysEl)) : undefined;
    let lastDays = -1;
    let booted = false;
    const pad = (n: number, len = 2) => String(n).padStart(len, '0');

    const tick = () => {
      const diff = Math.max(0, Date.now() - start);
      const total = Math.floor(diff / 1000);
      const days = Math.floor(total / 86400);
      if (nums.hours) nums.hours.textContent = pad(Math.floor((total % 86400) / 3600));
      if (nums.mins) nums.mins.textContent = pad(Math.floor((total % 3600) / 60));
      if (nums.secs) nums.secs.textContent = pad(total % 60);

      if (days !== lastDays) {
        if (daysOdo) {
          if (!booted) daysOdo.roll(days);
          else daysOdo.setValue(days);
        } else if (daysEl) {
          daysEl.textContent = String(days);
        }
        lastDays = days;
        booted = true;
      }
    };

    tick();
    window.setInterval(tick, 1000);
  };

  initUptime();
  document.addEventListener('astro:page-load', initUptime);
</script>
