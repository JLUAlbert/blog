---
// 博客运行时间：紧凑单行「已运行 · N 天」（原大号数字过大，已收敛），
// 时/分/秒改为无边框的极简三列，实时跳动。
const start = '2026-10-28T16:00:00+08:00';
const startMs = new Date(start).getTime();
const buildDays = Math.max(0, Math.floor((Date.now() - startMs) / 86400000));
const padDays = String(buildDays).padStart(3, '0');
---

<section
  class="glass-card uptime-card blur-in"
  data-uptime
  data-start={start}
  aria-label="博客已运行时间"
>
  <div class="uptime-head">
    <span class="uptime-label">已运行</span>
    <span class="uptime-days-num" data-days>{padDays}</span>
    <span class="uptime-days-unit">天</span>
    <span class="uptime-since">Since Oct 28, 2026</span>
  </div>

  <div class="uptime-grid">
    <span><b data-unit="hours">00</b>时</span>
    <span><b data-unit="mins">00</b>分</span>
    <span><b data-unit="secs">00</b>秒</span>
  </div>
</section>

<style>
  /* 与「最新」卡片统一内边距，保持两栏节奏一致 */
  .uptime-card {
    display: grid;
    gap: 10px;
    padding: 22px 24px 24px;
    max-width: 680px;
  }

  .uptime-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .uptime-label {
    color: var(--paper-accent);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .uptime-days-num {
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 1.6rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .uptime-days-unit {
    color: var(--paper-ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .uptime-since {
    margin-left: auto;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  /* 时/分/秒：极简三列，去掉原先的边框小格 */
  .uptime-grid {
    display: flex;
    align-items: baseline;
    gap: 18px;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
  }

  .uptime-grid b {
    margin-right: 3px;
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .uptime-grid {
      gap: 14px;
    }

    .uptime-since {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<script>
  let timer = 0;

  const initUptime = () => {
    const card = document.querySelector<HTMLElement>('[data-uptime]');
    if (!card) return;

    const start = new Date(card.dataset.start ?? '').getTime();
    if (Number.isNaN(start)) return;

    const nums: Record<string, HTMLElement | null> = {};
    card.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
      nums[el.dataset.unit ?? ''] = el;
    });

    const daysEl = card.querySelector<HTMLElement>('[data-days]');
    let lastDays = -1;
    const pad = (n: number, len = 2) => String(n).padStart(len, '0');

    const tick = () => {
      const diff = Math.max(0, Date.now() - start);
      const total = Math.floor(diff / 1000);
      const days = Math.floor(total / 86400);
      if (nums.hours) nums.hours.textContent = pad(Math.floor((total % 86400) / 3600));
      if (nums.mins) nums.mins.textContent = pad(Math.floor((total % 3600) / 60));
      if (nums.secs) nums.secs.textContent = pad(total % 60);

      if (days !== lastDays) {
        if (daysEl) daysEl.textContent = pad(days, 3);
        lastDays = days;
      }
    };

    tick();
    if (timer) window.clearInterval(timer);
    timer = window.setInterval(tick, 1000);
  };

  initUptime();
  document.addEventListener('astro:page-load', initUptime);
</script>
