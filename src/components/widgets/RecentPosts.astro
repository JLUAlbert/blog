---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../data/site';
import { createRecentBlogHeatmap } from '../../utils/blog-heatmap';
import { getUiText } from '../../utils/ui-text';

interface Props {
  count?: number;
  excludeDraft?: boolean;
}

const { count = 6, excludeDraft = true } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const { latestPosts } = createRecentBlogHeatmap(posts, 4, count);
const ui = getUiText(await getSiteConfig());
const formatDate = new Intl.DateTimeFormat(ui.locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

{
  latestPosts.length > 0 && (
    <section class="glass-card recent-card blur-in" aria-label={ui.heatmap.latestPublishedPosts}>
      <strong class="recent-label">{ui.heatmap.latest}</strong>
      <div class="latest-list">
        {latestPosts.map((post) => (
          <a
            class="latest-link hover-lift-soft"
            href={post.href}
            aria-label={ui.heatmap.openLatestPost(post.title)}
          >
            <em>{post.title}</em>
            <time datetime={post.date.toISOString()}>{formatDate.format(post.date)}</time>
            <span class="latest-icon" aria-hidden="true">
              <Icon name="external" size={15} />
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  /* 与「已运行」卡片统一内边距 */
  .recent-card {
    display: grid;
    gap: 16px;
    padding: 22px 24px 24px;
    max-width: 680px;
  }

  /* 整框悬停上浮：与顶栏 / 导航卡 / 影片卡共用 --hover-lift。
     这里用独立的 translate 属性而不是 transform —— 卡片同时带 .blur-in，
     入场动画占用了 transform，直接写 transform 会互相覆盖。
     .glass-card:hover 自带的 -1px 位移也一并归零，避免叠加成 -4px。 */
  .recent-card {
    transition:
      translate 280ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 280ms ease,
      border-color 280ms ease;
  }

  .recent-card:hover,
  .recent-card:focus-within {
    translate: 0 calc(-1 * var(--hover-lift, 3px));
    transform: none;
    border-color: var(--paper-line-strong);
    box-shadow: 0 16px 34px color-mix(in srgb, var(--paper-ink) 14%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-card {
      transition: none;
    }

    .recent-card:hover,
    .recent-card:focus-within {
      translate: none;
    }
  }

  .recent-label {
    color: var(--paper-accent);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .latest-list {
    display: grid;
    gap: 2px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 30px;
    align-items: center;
    min-width: 0;
    gap: 16px;
    padding: 11px 0;
    color: inherit;
    text-decoration: none;
  }

  .latest-link + .latest-link {
    border-top: 1px solid var(--paper-line);
  }

  .latest-link em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 1.08rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.6;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-link time {
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .latest-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .latest-link:hover .latest-icon,
  .latest-link:focus-visible .latest-icon {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .latest-link:focus-visible {
    border-radius: 7px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }
</style>
