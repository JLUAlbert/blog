---
import Icon from '../Icon.astro';
import { getCollection } from 'astro:content';

function shuffle<T>(items: T[]): T[] {
  const pool = [...items];
  for (let i = pool.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [pool[i], pool[j]] = [pool[j], pool[i]];
  }
  return pool;
}

function excerpt(text: string, maxLength = 60) {
  const plain = text
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/[#>*`_\-\[\]()!]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > maxLength ? `${plain.slice(0, maxLength)}…` : plain;
}

const posts = await getCollection('blog', ({ data }) => !data.draft);
const vibes = await getCollection('vibe');
const books = await getCollection('book', ({ data }) => !data.draft);
const movies = await getCollection('movie', ({ data }) => !data.draft);

const pickedPosts = shuffle(posts).slice(0, 3);
const pickedVibe = shuffle(vibes)[0];
const pickedBook = shuffle(books)[0];
const pickedMovie = shuffle(movies)[0];

const formatDate = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: 'numeric',
});
---

<article class="glass-card picks-card" aria-label="Random picks">
  <aside class="picks-tip">
    <strong>Random Picks</strong>
    <div class="picks-list">
      {
        pickedPosts.map((post) => (
          <a class="pick-link" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
            <em>{post.data.title}</em>
            <time datetime={post.data.date?.toISOString?.() ?? undefined}>
              {post.data.date ? formatDate.format(post.data.date) : 'Blog'}
            </time>
            <span class="pick-icon" aria-hidden="true">
              <Icon name="external" size={15} />
            </span>
          </a>
        ))
      }
      {
        pickedVibe && (
          <a class="pick-link" href="/vibe" aria-label={`Open vibe ${pickedVibe.data.title}`}>
            <em>
              {pickedVibe.data.title}
              {pickedVibe.body && <span class="pick-note"> — {excerpt(pickedVibe.body)}</span>}
            </em>
            <time>Vibe</time>
            <span class="pick-icon" aria-hidden="true">
              <Icon name="external" size={15} />
            </span>
          </a>
        )
      }
      {
        pickedMovie && (
          <a class="pick-link" href="/movie" aria-label={`Open movie ${pickedMovie.data.title}`}>
            <em>
              {pickedMovie.data.title}
              {pickedMovie.data.creator && (
                <span class="pick-note"> — {pickedMovie.data.creator}</span>
              )}
            </em>
            <time>Movie</time>
            <span class="pick-icon" aria-hidden="true">
              <Icon name="external" size={15} />
            </span>
          </a>
        )
      }
      {
        pickedBook && (
          <a class="pick-link" href={`/book/${pickedBook.id}/`} aria-label={`Open book ${pickedBook.data.title}`}>
            <em>
              {pickedBook.data.title}
              {pickedBook.data.author && <span class="pick-note"> — {pickedBook.data.author}</span>}
            </em>
            <time>Book</time>
            <span class="pick-icon" aria-hidden="true">
              <Icon name="external" size={15} />
            </span>
          </a>
        )
      }
    </div>
  </aside>
</article>

<style>
  .picks-card {
    padding: 18px 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .picks-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .picks-tip {
    display: grid;
    gap: 6px;
    padding: 10px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .picks-tip strong {
    color: var(--paper-accent);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .picks-list {
    display: grid;
    gap: 4px;
  }

  .pick-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 24px;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .pick-link em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick-link:hover em {
    color: var(--paper-accent);
  }

  .pick-note {
    color: var(--paper-ink-soft);
    font-weight: 400;
  }

  .pick-link time {
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .pick-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .pick-link:hover .pick-icon {
    background: var(--paper-accent-soft);
  }
</style>
