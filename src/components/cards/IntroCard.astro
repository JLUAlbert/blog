---
interface Intro {
  title: string;
  name: string;
  body: string[];
}

const { intro } = Astro.props as { intro: Intro };
---

<article class="glass-card intro-card blur-in">
  <div class="intro-copy">
    <h2>
      {intro.title.replace(intro.name, '').trim()}{' '}<em>{intro.name}</em>
    </h2>
    {intro.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</article>

<style>
  .intro-card {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .intro-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .intro-copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: none;
    flex-direction: column;
    align-items: flex-start;
  }

  h2 {
    margin: 0;
    color: var(--paper-ink);
    max-width: none;
    font-size: clamp(2.2rem, 4vw, 3.35rem);
    line-height: 1.04;
    white-space: nowrap;
  }

  h2 em {
    color: var(--paper-accent);
    font-style: italic;
  }

  p {
    width: 100%;
    margin: 0 0 12px;
    color: var(--paper-ink);
    max-width: 66ch;
    font-size: 1.02rem;
    line-height: 1.92;
  }

  p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .intro-card {
      padding: 0;
    }

    h2 {
      font-size: 1.7rem;
      white-space: normal;
    }
  }
</style>
