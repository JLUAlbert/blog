---
import Icon from '../Icon.astro';

interface NavItem {
  icon: string;
  title: string;
  subtitle: string;
  href: string;
}

const { items, counts = {} } = Astro.props as {
  items: NavItem[];
  counts?: Record<string, number>;
};
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
    return href;
  }

  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<article class="nav-card">
  <nav aria-label="identity websites" data-blur-group>
    {
      items.map((item) => (
        <a class="nav-item blur-in hover-lift" href={withBase(item.href)}>
          <span class="nav-icon">
            <Icon name={item.icon} />
          </span>
          <span class="nav-text">
            <strong>
              <span class="nav-count">{counts[item.href] ?? 0}</span>
              {item.title}
            </strong>
            <small>{item.subtitle}</small>
          </span>
          <Icon name="external" />
        </a>
      ))
    }
  </nav>
</article>

<style>
  .nav-card {
    width: 100%;
    padding: 6px 0 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  nav {
    display: grid;
    width: 100%;
    gap: 8px;
  }

  .nav-item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 18px;
    gap: 12px;
    align-items: center;
    /* 左右各留 10px 作为 hover 时的浮起底色，再用负外边距抵消，保持文字对齐 */
    padding: 8px 10px;
    margin: 0 -10px;
    border-radius: 12px;
    background: transparent;
    color: var(--paper-ink);
    text-decoration: none;
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 280ms ease,
      background-color 280ms ease,
      color 180ms ease;
  }

  .nav-item:hover,
  .nav-item:focus-visible {
    background: var(--paper-surface);
    color: var(--paper-accent);
    transform: translateY(-3px);
    box-shadow: 0 14px 28px color-mix(in srgb, var(--paper-ink) 12%, transparent);
  }

  .nav-icon,
  .nav-item > svg {
    color: var(--paper-accent);
  }

  .nav-icon svg,
  .nav-item > svg {
    width: 20px;
    height: 20px;
  }

  strong,
  small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  strong {
    font-size: 0.96rem;
    font-weight: 650;
  }

  /* 计数：小号等宽数字 + 强调色，紧贴在 Blog / Vibe / Movies 字样之前 */
  .nav-count {
    display: inline-block;
    margin-right: 6px;
    color: var(--paper-accent);
    font-family: var(--font-ui-label);
    font-size: 0.82rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-item:hover .nav-count,
  .nav-item:focus-visible .nav-count {
    transform: translateY(-1px);
  }

  small {
    margin-top: 2px;
    color: var(--paper-ink-soft);
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .nav-card {
      padding: 0;
    }

    nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px;
    }

    .nav-item {
      width: 100%;
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 10px;
      justify-content: start;
      min-width: 0;
      padding: 9px 10px;
    }

    .nav-icon {
      display: grid;
      place-items: center;
    }

    strong {
      max-width: 100%;
      text-align: left;
    }

    small,
    .nav-item > svg {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-item:hover,
    .nav-item:focus-visible {
      transform: none;
    }
  }
</style>
