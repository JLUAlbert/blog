---
import { Github, ListTree, Menu, Palette } from 'lucide-astro';
import SiteSearch from './SiteSearch.astro';
import TocTree from './TocTree.astro';
import { getRouteLabels, getSiteConfig, getTopNavLinks } from '../../data/site';
import { getUiText } from '../../utils/ui-text';
import type { TocItem } from '../../utils/toc-tree';

interface Props {
  showTocIcon?: boolean;
  tocItems?: TocItem[];
}

const { showTocIcon = false, tocItems = [] } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, search } = siteConfig;
const ui = getUiText(siteConfig);
const links = await getTopNavLinks();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPathname =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
const currentPath = currentPathname.replace(/\/$/, '') || '/';

function withBase(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
    return href;
  }

  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

function isActive(href: string) {
  if (href.startsWith('http')) return false;

  const normalizedHref = href.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return currentPath === '/';
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}

const routeLabels = getRouteLabels();
const activeRoute = Object.entries(routeLabels).find(
  ([route]) => currentPath === route || currentPath.startsWith(`${route}/`),
);
const brandRouteLabel = activeRoute?.[1];
const shouldShowTocAction = showTocIcon && tocItems.length > 0;
---

<header
  class="blog-top-nav"
  data-pagefind-ignore
  data-toc-open-label={ui.toc.open}
  data-toc-close-label={ui.toc.close}
>
  <button
    class="mobile-menu-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-nav-menu"
    data-mobile-menu-toggle
  >
    <Menu size={18} stroke-width={2} />
  </button>

  <a class="brand" href={withBase('/')} aria-label={`Go to ${site.title} home`}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-title">
      <span>{site.title}</span>
      {brandRouteLabel && <span class="brand-route"> · {brandRouteLabel}</span>}
    </span>
  </a>

  <nav class="nav-links" aria-label="Article navigation">
    <span class="tab-pill" aria-hidden="true"></span>
    {
      links.map((link) =>
        link.disabled ? (
          <span
            class="nav-link nav-link-placeholder"
            aria-disabled="true"
            title="Projects content placeholder"
          >
            {link.label}
          </span>
        ) : (
          <a class:list={['nav-link', { active: isActive(link.href) }]} href={withBase(link.href)}>
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <nav
    class="mobile-menu-panel"
    id="mobile-nav-menu"
    aria-label="Mobile navigation"
    data-mobile-menu
  >
    {
      links.map((link) =>
        link.disabled ? (
          <span class="mobile-menu-link mobile-menu-placeholder" aria-disabled="true">
            {link.label}
          </span>
        ) : (
          <a
            class:list={['mobile-menu-link', { active: isActive(link.href) }]}
            href={withBase(link.href)}
            data-mobile-menu-link
          >
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <div class="nav-actions" aria-label="Page actions">
    <a
      class="nav-github"
      href="https://github.com/JLUAlbert"
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
      title="GitHub"
    >
      <Github size={17} stroke-width={2} />
    </a>
    <button type="button" data-palette-toggle aria-label="Change theme color">
      <Palette size={17} stroke-width={2} />
    </button>
    {search.enabled && <SiteSearch search={search} />}
    {
      shouldShowTocAction && (
        <button
          class="toc-action"
          type="button"
          aria-label={ui.toc.open}
          aria-expanded="false"
          aria-controls="mobile-toc-menu"
          title={ui.toc.title}
          data-mobile-toc-trigger
        >
          <ListTree size={17} stroke-width={2} />
        </button>
      )
    }
  </div>

  {
    shouldShowTocAction && (
      <nav
        class="mobile-toc-panel"
        id="mobile-toc-menu"
        aria-label={ui.toc.title}
        data-nav-toc-menu
        data-toc-root
        data-toc-scroll
      >
        <p>{ui.toc.title}</p>
        <TocTree items={tocItems} idPrefix="nav-toc" navLink />
      </nav>
    )
  }
</header>

<script>
  let navigationSequence = 0;
  let activeNavigationId = 0;

  const clearPendingNavigation = (navigationId?: number) => {
    if (navigationId && navigationId !== activeNavigationId) {
      return;
    }

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      delete header.dataset.navPending;
      header.removeAttribute('aria-busy');

      for (const link of header.querySelectorAll<HTMLElement>('[data-nav-link-pending]')) {
        delete link.dataset.navLinkPending;
      }
    }

    activeNavigationId = 0;
  };

  const startPendingNavigation = (sourceElement?: Element) => {
    const sourceLink = sourceElement?.closest<HTMLAnchorElement>('.blog-top-nav a[href]');

    if (!sourceLink) {
      return 0;
    }

    const navigationId = ++navigationSequence;
    const pendingHref = sourceLink.href;
    activeNavigationId = navigationId;

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      header.dataset.navPending = 'true';
      header.setAttribute('aria-busy', 'true');

      for (const link of header.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        link.toggleAttribute('data-nav-link-pending', link.href === pendingHref);
      }
    }

    return navigationId;
  };

  const initMobileTopNav = () => {
    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const tocTrigger = header.querySelector<HTMLButtonElement>('[data-mobile-toc-trigger]');
      const tocMenu = header.querySelector<HTMLElement>('[data-nav-toc-menu]');

      if (!header.dataset.scrollHideReady) {
        header.dataset.scrollHideReady = 'true';

        const topRevealOffset = 24;
        const hideAfterOffset = 96;
        const scrollIntentDelta = 8;
        let lastScrollY = window.scrollY;
        let scrollFrame = 0;

        const setNavHidden = (hidden: boolean) => {
          header.dataset.navHidden = hidden ? 'true' : 'false';
          header.toggleAttribute('inert', hidden);
          header.toggleAttribute('aria-hidden', hidden);
        };

        const shouldKeepVisible = () =>
          window.scrollY <= topRevealOffset ||
          header.dataset.mobileMenuOpen === 'true' ||
          header.dataset.mobileTocOpen === 'true' ||
          header.matches(':focus-within');

        const updateNavVisibility = () => {
          scrollFrame = 0;
          const currentScrollY = window.scrollY;
          const scrollDelta = currentScrollY - lastScrollY;

          if (shouldKeepVisible()) {
            setNavHidden(false);
            lastScrollY = currentScrollY;
            return;
          }

          if (Math.abs(scrollDelta) < scrollIntentDelta) {
            return;
          }

          setNavHidden(scrollDelta > 0 && currentScrollY > hideAfterOffset);
          lastScrollY = currentScrollY;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (scrollFrame) {
              return;
            }

            scrollFrame = window.requestAnimationFrame(updateNavVisibility);
          },
          { passive: true },
        );

        window.addEventListener('resize', () => {
          if (window.scrollY <= topRevealOffset) {
            setNavHidden(false);
          }
        });

        setNavHidden(false);
      }

      if (toggle && menu && !header.dataset.mobileMenuReady) {
        header.dataset.mobileMenuReady = 'true';

        const setMenuOpen = (open: boolean) => {
          header.dataset.mobileMenuOpen = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            open ? 'Close navigation menu' : 'Open navigation menu',
          );
        };
        const setTocOpen = (open: boolean) => {
          if (!tocTrigger || !tocMenu) {
            return;
          }

          const tocOpenLabel = header.dataset.tocOpenLabel ?? 'Open table of contents';
          const tocCloseLabel = header.dataset.tocCloseLabel ?? 'Close table of contents';

          header.dataset.mobileTocOpen = open ? 'true' : 'false';
          tocTrigger.setAttribute('aria-expanded', String(open));
          tocTrigger.setAttribute('aria-label', open ? tocCloseLabel : tocOpenLabel);
        };

        toggle.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileMenuOpen !== 'true';
          setMenuOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setTocOpen(false);
          }
        });

        menu.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-mobile-menu-link]')) {
            setMenuOpen(false);
          }
        });

        tocTrigger?.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileTocOpen !== 'true';
          setTocOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setMenuOpen(false);
          }
        });

        tocMenu?.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-nav-toc-link]')) {
            setTocOpen(false);
          }
        });

        document.addEventListener('click', (event) => {
          if (!header.contains(event.target as Node)) {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });
      }
    }
  };

  initMobileTopNav();
  document.addEventListener('astro:before-preparation', (event) => {
    const navigationId = startPendingNavigation(event.sourceElement);

    if (!navigationId) {
      return;
    }

    const loadPage = event.loader;

    event.loader = async () => {
      try {
        await loadPage();

        if (event.signal.aborted) {
          clearPendingNavigation(navigationId);
        }
      } catch (error) {
        clearPendingNavigation(navigationId);
        throw error;
      }
    };
  });
  document.addEventListener('astro:after-swap', () => clearPendingNavigation());
  document.addEventListener('astro:page-load', initMobileTopNav);
</script>

<style>
  .blog-top-nav {
    position: fixed;
    top: 18px;
    right: 0;
    left: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    width: min(calc(100% - 32px), 900px);
    min-height: 56px;
    padding: 10px 14px 10px 18px;
    margin: 0 auto;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-nav);
    box-shadow: var(--paper-shadow);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 180ms ease,
      transform 220ms ease;
    will-change: transform;
  }

  .blog-top-nav::after {
    position: absolute;
    right: 14px;
    bottom: -1px;
    left: 14px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--paper-accent) 6%,
      var(--paper-accent) 94%,
      transparent
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: center;
    will-change: opacity, transform;
  }

  .blog-top-nav[data-nav-pending='true'] {
    cursor: progress;
  }

  .blog-top-nav[data-nav-pending='true']::after {
    animation: nav-route-progress 900ms ease-in-out infinite;
    opacity: 1;
  }

  .blog-top-nav[data-nav-hidden='true'] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-100% - 24px));
  }

  .mobile-menu-toggle,
  .mobile-menu-panel,
  .mobile-toc-panel {
    display: none;
  }

  .brand,
  a.nav-link,
  a.mobile-menu-link,
  .mobile-toc-panel a {
    color: var(--paper-ink);
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
  }

  .brand-mark {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper-accent);
    box-shadow: none;
  }

  .nav-links {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 4px;
  }

  /* 滑动指示器药丸：绝对定位的背景高亮，随激活项以 spring 曲线弹性滑移 */
  .tab-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    z-index: 0;
    width: 0;
    border-radius: 8px;
    background: var(--paper-control-hover);
    transform: translateX(0);
    pointer-events: none;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform, width;
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    justify-content: center;
    min-width: 74px;
    padding: 9px 12px 12px;
    border-radius: 8px;
    color: var(--paper-ink-soft);
    font-size: 0.9rem;
    font-weight: 700;
  }

  a.nav-link:hover,
  a.nav-link[data-nav-link-pending] {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }

  a.nav-link.active {
    color: var(--paper-accent);
  }

  .nav-link[data-nav-link-pending]::after {
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--paper-accent);
    content: '';
    transform: translateX(-50%);
  }

  .nav-link[data-nav-link-pending]::after,
  .brand[data-nav-link-pending] .brand-mark {
    animation: nav-pending-pulse 620ms ease-in-out infinite alternate;
  }

  .nav-link-placeholder {
    color: var(--paper-ink-faint);
    cursor: default;
  }

  .nav-actions {
    display: flex;
    gap: 8px;
  }

  .nav-actions a,
  .nav-actions button,
  .mobile-menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink);
    cursor: pointer;
  }

  .mobile-menu-toggle,
  .nav-actions .toc-action {
    display: none;
  }

  .nav-actions a:hover,
  .nav-actions button:hover,
  .mobile-menu-toggle:hover {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }

  @media (max-width: 720px) {
    .blog-top-nav {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 10px;
      top: 10px;
      width: min(calc(100% - 20px), 520px);
      min-height: 54px;
      padding: 8px 10px 8px 14px;
      border-radius: 8px;
    }

    .nav-links {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-grid;
    }

    .brand {
      min-width: 0;
      gap: 8px;
      font-size: 0.95rem;
    }

    .brand-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .brand-mark {
      flex: 0 0 auto;
    }

    .nav-actions {
      gap: 6px;
    }

    .nav-actions a {
      display: none;
    }

    /* 发布台链接移除后，GitHub 图标重定位到该位置，移动端也保持可见 */
    .nav-actions a.nav-github {
      display: inline-grid;
    }

    .nav-actions a,
    .nav-actions button,
    .mobile-menu-toggle {
      width: 36px;
      height: 36px;
      border-radius: 7px;
    }

    .nav-actions .toc-action {
      display: inline-grid;
    }

    .mobile-menu-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      display: grid;
      min-width: min(260px, calc(100vw - 20px));
      gap: 4px;
      padding: 8px;
      border: 1px solid var(--paper-line);
      border-radius: 8px;
      background: var(--paper-nav);
      box-shadow: var(--paper-shadow);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    .mobile-toc-panel {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      display: grid;
      width: min(300px, calc(100vw - 20px));
      max-height: min(52vh, 420px);
      gap: 8px;
      overflow: auto;
      padding: 10px;
      border: 1px solid var(--paper-line);
      border-radius: 8px;
      background: var(--paper-nav);
      box-shadow: var(--paper-shadow);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    .blog-top-nav[data-mobile-menu-open='true'] .mobile-menu-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .blog-top-nav[data-mobile-toc-open='true'] .mobile-toc-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-menu-link {
      display: flex;
      align-items: center;
      min-height: 38px;
      padding: 8px 10px;
      border-radius: 7px;
      color: var(--paper-ink-soft);
      font-size: 0.92rem;
      font-weight: 700;
    }

    .mobile-menu-link:hover,
    .mobile-menu-link.active,
    .mobile-menu-link[data-nav-link-pending] {
      background: var(--paper-control-hover);
      color: var(--paper-accent);
    }

    .mobile-menu-placeholder {
      color: var(--paper-ink-faint);
    }

    .mobile-toc-panel p {
      margin: 0;
      padding: 2px 2px 4px;
      color: var(--paper-ink-faint);
      font-family: var(--font-ui-label);
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1.2;
      text-transform: uppercase;
    }
  }

  @media (min-width: 721px) {
    .brand-route {
      display: none;
    }

    .nav-actions .toc-action {
      display: none;
    }
  }

  @keyframes nav-route-progress {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    12% {
      opacity: 1;
    }

    72% {
      opacity: 1;
      transform: scaleX(1);
    }

    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  @keyframes nav-pending-pulse {
    from {
      opacity: 0.42;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-top-nav {
      transition: none;
    }

    .blog-top-nav[data-nav-pending='true']::after {
      animation: none;
      opacity: 1;
      transform: scaleX(1);
    }

    .nav-link[data-nav-link-pending]::after,
    .brand[data-nav-link-pending] .brand-mark {
      animation: none;
    }
  }
</style>

<script>
  // Vibe 时间线逐项「遮罩上移」：承接原「文章正文逐行显现」的动效语言，
  // 改为对 Vibe 页每个 .vibe-item 做容器裁切 + 内层上移，滚动进入时显现。
  const initVibeMaskUp = () => {
    const items = Array.from(document.querySelectorAll('.vibe-item'));
    if (!items.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    items.forEach((item) => {
      if (item.dataset.vibeMask === '1') return;
      item.dataset.vibeMask = '1';

      // 关闭主题自带的淡入，改由遮罩上移承担入场
      item.style.animation = 'none';

      const dot = item.querySelector('.vibe-dot');
      const mask = document.createElement('div');
      mask.className = 'vibe-mask';
      const inner = document.createElement('div');
      inner.className = 'vibe-mask__inner';

      Array.from(item.childNodes).forEach((node) => {
        if (node === dot) return;
        inner.appendChild(node);
      });
      mask.appendChild(inner);
      item.appendChild(mask);
      // 圆点保留在遮罩之外（直接挂到 item），避免被裁切隐藏
      if (dot) item.appendChild(dot);
    });

    if (reduce) {
      items.forEach((item) => item.classList.add('is-revealed'));
      return;
    }

    try {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('is-revealed');
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      items.forEach((item) => io.observe(item));
    } catch {
      // 兜底：Observer 不可用时直接全部显现，避免内容被遮罩永久隐藏
      items.forEach((item) => item.classList.add('is-revealed'));
    }
  };

  document.addEventListener('astro:page-load', initVibeMaskUp);
  initVibeMaskUp();

  // Movies 书架重构：去除导演（creator），将星级（rating）移到片名正下方并居中。
  // 配合 motion.css 中 [data-movie-shelf] 门控的「图片悬停微放大」与「星级居中」样式。
  const initMovieShelf = () => {
    const shelf = document.querySelector('[data-movie-shelf]');
    if (!shelf) return;

    shelf.querySelectorAll('.navfolio-media-shelf__item').forEach((item) => {
      if (item.dataset.movieProcessed === '1') return;
      item.dataset.movieProcessed = '1';

      const content = item.querySelector('.navfolio-media-shelf__content');
      if (!content) return;

      const strong = content.querySelector('strong');
      const meta = content.querySelector('.navfolio-media-shelf__meta');
      const creator = content.querySelector('.navfolio-media-shelf__creator');
      const rating = content.querySelector('.navfolio-media-shelf__rating');

      // 1) 去除导演
      if (creator) creator.remove();

      // 2) 星级移到片名正下方，并打上居中标记
      if (rating) {
        rating.classList.add('is-rating-moved');
        if (strong) {
          content.insertBefore(rating, strong.nextSibling);
        } else {
          content.appendChild(rating);
        }
      }

      // 3) meta 已无子节点时一并移除，避免残留空标签影响布局
      if (meta && !meta.childElementCount) meta.remove();
    });
  };

  document.addEventListener('astro:page-load', initMovieShelf);
  initMovieShelf();
</script>
