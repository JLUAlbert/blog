---
import { Search, X } from 'lucide-astro';
import { getSiteConfig, type SiteSearch as SiteSearchConfig } from '../../data/site';
import navfolioConfig from '../../../navfolio.config';
import { getPageModuleRoute } from '../../plugins/config';
import { getUiText } from '../../utils/ui-text';

interface Props {
  search: SiteSearchConfig;
}

const { search } = Astro.props;
const ui = getUiText(await getSiteConfig());
const shortcutLabel = search.shortcut === 'mod+k' ? 'Ctrl K / Cmd K' : search.shortcut;
const projectsRoute = getPageModuleRoute(navfolioConfig, 'projects');
const vibeRoute = getPageModuleRoute(navfolioConfig, 'vibe');
---

<div
  class="site-search"
  data-site-search-root
  data-search-max-results={search.maxResults}
  data-search-idle-label={ui.search.idle}
  data-search-loading-label={ui.search.loading}
  data-search-empty-label={ui.search.empty}
  data-search-unavailable-label={ui.search.unavailable}
  data-search-count-label={ui.search.resultCount}
  data-search-kind-blog-note={ui.search.resultKinds.blogNote}
  data-search-kind-blog-index={ui.search.resultKinds.blogIndex}
  data-search-kind-vibe={ui.search.resultKinds.vibe}
  data-search-kind-project={ui.search.resultKinds.project}
  data-search-kind-page={ui.search.resultKinds.page}
  data-search-route-vibe={vibeRoute}
  data-search-route-projects={projectsRoute}
  data-search-match-label={ui.search.matchedPassage}
  data-pagefind-ignore
>
  <button
    class="site-search-trigger"
    type="button"
    aria-label={ui.search.trigger}
    aria-expanded="false"
    aria-controls="site-search-dialog"
    title={`${ui.search.title} (${shortcutLabel})`}
    data-site-search-trigger
  >
    <Search size={17} stroke-width={2} />
  </button>

  <div class="site-search-layer" data-site-search-layer data-site-search-backdrop>
    <section
      class="site-search-dialog"
      id="site-search-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="site-search-title"
      data-site-search-dialog
    >
      <header class="site-search-head">
        <div>
          <p id="site-search-title">{ui.search.title}</p>
          <span>{shortcutLabel}</span>
        </div>
        <button
          class="site-search-close"
          type="button"
          aria-label={ui.search.close}
          title={ui.search.close}
          data-site-search-close
        >
          <X size={17} stroke-width={2} />
        </button>
      </header>

      <label class="site-search-input-wrap">
        <Search size={16} stroke-width={2} aria-hidden="true" />
        <input
          type="search"
          placeholder={search.placeholder}
          autocomplete="off"
          spellcheck="false"
          data-site-search-input
        />
      </label>

      <p class="site-search-status" data-site-search-status>{ui.search.idle}</p>
      <ol class="site-search-results" data-site-search-results></ol>
    </section>
  </div>
</div>

<script>
  import { initSiteSearch } from '../../utils/site-search';

  initSiteSearch();
</script>

<style>
  .site-search {
    display: contents;
  }

  .site-search-trigger,
  .site-search-close {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink);
    cursor: pointer;
  }

  .site-search-trigger:hover,
  .site-search-trigger:focus-visible,
  .site-search-close:hover,
  .site-search-close:focus-visible {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
    outline: none;
  }

  .site-search-layer {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: start center;
    padding: 96px 18px 24px;
    background: rgba(17, 20, 17, 0.5);
    backdrop-filter: blur(7px) saturate(1.15);
    -webkit-backdrop-filter: blur(7px) saturate(1.15);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  :root[data-theme='dark'] .site-search-layer {
    background: rgba(0, 0, 0, 0.68);
  }

  .site-search-layer[data-search-open='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  .site-search-dialog {
    display: grid;
    width: min(100%, 620px);
    max-height: min(72vh, 620px);
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    background: var(--paper-nav);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 24px 60px -18px rgba(0, 0, 0, 0.42),
      var(--paper-shadow-lift);
    color: var(--paper-ink);
    transform: translateY(-14px) scale(0.97);
    opacity: 0;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease;
  }

  .site-search-layer[data-search-open='true'] .site-search-dialog {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .site-search-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 12px 10px 16px;
    border-bottom: 1px solid var(--paper-line);
  }

  .site-search-head p,
  .site-search-head span,
  .site-search-status {
    font-family: var(--font-ui-label);
  }

  .site-search-head p {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .site-search-head span {
    display: inline-block;
    margin-top: 2px;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .site-search-input-wrap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    margin: 12px;
    padding: 10px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink-soft);
  }

  .site-search-input-wrap:focus-within {
    border-color: var(--paper-accent);
    background: var(--paper-surface);
    color: var(--paper-accent);
    box-shadow: 0 0 0 3px rgba(127, 148, 122, 0.16);
  }

  .site-search-input-wrap input {
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--paper-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.4;
  }

  .site-search-input-wrap input::placeholder {
    color: var(--paper-ink-faint);
  }

  .site-search-status {
    min-height: 20px;
    margin: 0;
    padding: 0 16px 10px;
    color: var(--paper-ink-faint);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* 空文案（idle 已移除）时不占位 */
  .site-search-status[data-empty='true'] {
    display: none;
  }

  .site-search-results {
    display: grid;
    gap: 6px;
    max-height: min(46vh, 430px);
    margin: 0;
    overflow: auto;
    padding: 0 10px 12px;
    list-style: none;
  }

  .site-search-results :global(li) {
    min-width: 0;
  }

  /* 结果逐条错峰入场 */
  .site-search-results :global(li.site-search-result-item) {
    animation: search-result-in 460ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--search-index, 0) * 46ms);
  }

  @keyframes search-result-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .site-search-results :global(a) {
    position: relative;
    display: grid;
    gap: 7px;
    min-width: 0;
    padding: 11px 34px 12px 14px;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--paper-ink);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  /* hover 时左侧出现强调色竖条 + 右侧箭头 */
  .site-search-results :global(a::before) {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 6px;
    width: 2px;
    border-radius: 2px;
    background: var(--paper-accent);
    opacity: 0;
    transform: scaleY(0.4);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-search-results :global(a::after) {
    content: '→';
    position: absolute;
    top: 50%;
    right: 14px;
    color: var(--paper-accent);
    font-size: 0.92rem;
    line-height: 1;
    opacity: 0;
    transform: translate(-4px, -50%);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-search-results :global(a:hover),
  .site-search-results :global(a:focus-visible) {
    border-color: var(--paper-line);
    background: var(--paper-control-hover);
    outline: none;
    transform: translateX(2px);
    box-shadow: 0 8px 20px -14px rgba(0, 0, 0, 0.5);
  }

  .site-search-results :global(a:hover::before),
  .site-search-results :global(a:focus-visible::before),
  .site-search-results :global(a:hover::after),
  .site-search-results :global(a:focus-visible::after) {
    opacity: 1;
    transform: translateY(0);
  }

  .site-search-results :global(a:hover::after),
  .site-search-results :global(a:focus-visible::after) {
    transform: translate(0, -50%);
  }

  .site-search-results :global(.site-search-result-title) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .site-search-results :global(.site-search-result-meta),
  .site-search-results :global(.site-search-result-match-label) {
    color: var(--paper-ink-faint);
    font-family: var(--font-ui-label);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
  }

  /* 分类徽标 + 路径 */
  .site-search-results :global(.site-search-result-meta) {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .site-search-results :global(.site-search-result-kind) {
    flex: none;
    padding: 2px 8px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-control);
    color: var(--paper-accent);
    font-family: var(--font-ui-label);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-search-results :global(.site-search-result-path) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--paper-ink-faint);
    font-family: var(--font-ui-label);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .site-search-results :global(.site-search-result-match) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 9px;
    align-items: start;
    padding-top: 2px;
  }

  .site-search-results :global(.site-search-result-match-label) {
    padding-top: 2px;
    white-space: nowrap;
  }

  .site-search-results :global(.site-search-result-excerpt) {
    min-width: 0;
    color: var(--paper-ink-soft);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .site-search-results :global(mark) {
    border-radius: 4px;
    background: var(--paper-control-hover);
    color: var(--paper-accent);
    font-weight: 700;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-search-dialog {
      transition: none;
    }

    .site-search-results :global(a) {
      transition: none;
    }

    .site-search-results :global(li.site-search-result-item) {
      animation: none;
    }

    .site-search-results :global(a:hover),
    .site-search-results :global(a:focus-visible) {
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .site-search-trigger {
      width: 36px;
      height: 36px;
      border-radius: 7px;
    }

    .site-search-layer {
      align-items: start;
      padding-top: 74px;
    }

    .site-search-dialog {
      max-height: calc(100vh - 96px);
    }

    .site-search-results {
      padding-inline: 8px;
    }

    .site-search-results :global(a) {
      padding: 10px;
    }

    .site-search-results :global(.site-search-result-match) {
      grid-template-columns: minmax(0, 1fr);
      gap: 5px;
    }
  }
</style>
