---
import MediaShelf, { type MediaShelfItem } from '@navfolio/mdx-components/MediaShelf.astro';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import BlogTopNav from './blog/BlogTopNav.astro';
import { getSiteConfig } from '../data/site';
import { getHtmlLang } from '../utils/ui-text';

interface Props {
  pageMeta: { title: string; subtitle: string; note: string };
  kicker: string;
  items: MediaShelfItem[];
  empty: string;
  variant?: 'shelf' | 'inline';
  countLabel?: string;
}

const { pageMeta, kicker, items, empty, variant = 'shelf', countLabel = 'items' } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, theme } = siteConfig;
const palette = theme.palette;
const htmlLang = getHtmlLang(siteConfig);
---

<!doctype html>
<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle} />
    <style>
      main {
        width: min(100%, 860px);
        padding-top: 126px;
        padding-bottom: 80px;
      }
      /* 表头与 blog 列表页一致：标题在左，副标题与说明文字在右，居中对齐 */
      .shelf-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
        gap: 32px;
        align-items: center;
        margin-bottom: clamp(38px, 6vw, 64px);
      }
      .shelf-header-main {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
      }
      .shelf-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        max-width: 300px;
        margin: 0;
        text-align: center;
      }
      .shelf-kicker {
        margin: 0;
        color: var(--paper-ink-faint);
        font-family: var(--font-ui-label);
        font-size: var(--type-label);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .shelf-title {
        margin: 8px 0 0;
        color: var(--paper-ink);
        font-size: clamp(2.1rem, 6vw, 3.6rem);
        font-weight: 400;
        line-height: 1.08;
      }
      .shelf-subtitle {
        max-width: 30ch;
        margin: 0;
        color: var(--paper-ink-soft);
        font-family: var(--font-ui-label);
        font-size: 1.03rem;
        line-height: 1.76;
      }
      .shelf-note,
      .shelf-count,
      .shelf-empty {
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
      }
      .shelf-note {
        max-width: 42ch;
        margin: 0;
        font-size: 0.7rem;
        line-height: 1.75;
      }
      @media (max-width: 720px) {
        .shelf-hero {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .shelf-copy {
          display: block;
          max-width: none;
          text-align: left;
        }
      }
      .shelf-heading {
        display: flex;
        gap: 10px;
        align-items: baseline;
        margin-bottom: 4px;
        padding-top: 24px;
        border-top: 1px solid var(--paper-line);
      }
      .shelf-count {
        font-size: 0.7rem;
      }
      .shelf-empty {
        margin: 24px 0 0;
        font-size: 0.76rem;
      }
      @media (max-width: 760px) {
        main {
          padding-top: 98px;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main data-movie-shelf>
      <header class="shelf-hero">
        <div class="shelf-header-main">
          <p class="shelf-kicker">{kicker}</p>
          <h1 class="shelf-title">{pageMeta.title}</h1>
        </div>
        <div class="shelf-copy">
          <p class="shelf-subtitle">{pageMeta.subtitle}</p>
          <p class="shelf-note">{pageMeta.note}</p>
        </div>
      </header>
      <div class="shelf-heading">
        <span class="shelf-count">{items.length} {countLabel}</span>
      </div>
      {
        items.length ? (
          <MediaShelf variant={variant} columns={4} items={items} />
        ) : (
          <p class="shelf-empty">{empty}</p>
        )
      }
    </main>
    <Footer />
  </body>
</html>
