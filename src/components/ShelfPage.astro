---
import MediaShelf, { type MediaShelfItem } from '@navfolio/mdx-components/MediaShelf.astro';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import BlogTopNav from './blog/BlogTopNav.astro';
import { getSiteConfig } from '../data/site';
import { getHtmlLang } from '../utils/ui-text';

interface ShelfSummary {
  works: number;
  totalMinutes: number;
  sinceYear: number | null;
  years: { year: number; titles: string[] }[];
}

interface Props {
  pageMeta: { title: string; subtitle: string; note: string };
  kicker: string;
  items: MediaShelfItem[];
  empty: string;
  variant?: 'shelf' | 'inline';
  countLabel?: string;
  summary?: ShelfSummary | null;
}

const {
  pageMeta,
  kicker,
  items,
  empty,
  variant = 'shelf',
  countLabel = 'items',
  summary = null,
} = Astro.props;
const siteConfig = await getSiteConfig();
const { site, theme } = siteConfig;
const palette = theme.palette;
const htmlLang = getHtmlLang(siteConfig);
---

<!doctype html>
<html lang={htmlLang} data-palette={palette}>
  <head>
    <BaseHead title={`${pageMeta.title} | ${site.title}`} description={pageMeta.subtitle} />
    <style>
      main {
        width: min(100%, 860px);
        padding-top: 126px;
        padding-bottom: 80px;
      }
      /* 表头与 blog 列表页一致：标题在左，副标题与说明文字在右，居中对齐 */
      .shelf-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
        gap: 32px;
        align-items: center;
        margin-bottom: clamp(38px, 6vw, 64px);
      }
      .shelf-header-main {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
      }
      .shelf-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        max-width: 300px;
        margin: 0;
        text-align: center;
      }
      .shelf-kicker {
        margin: 0;
        color: var(--paper-accent);
        font-family: var(--font-ui-label);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .shelf-title {
        margin: 8px 0 0;
        color: var(--paper-ink);
        font-size: clamp(2.1rem, 6vw, 3.6rem);
        font-weight: 400;
        line-height: 1.08;
      }
      .shelf-subtitle {
        max-width: 30ch;
        margin: 0;
        color: var(--paper-ink-soft);
        font-family: var(--font-ui-label);
        font-size: 1.03rem;
        line-height: 1.76;
      }
      .shelf-note,
      .shelf-count,
      .shelf-empty {
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
      }
      .shelf-note {
        max-width: 42ch;
        margin: 0;
        font-size: 0.7rem;
        line-height: 1.75;
      }
      @media (max-width: 720px) {
        .shelf-hero {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .shelf-copy {
          display: block;
          max-width: none;
          text-align: left;
        }
      }
      .shelf-heading {
        display: flex;
        gap: 10px;
        align-items: baseline;
        margin-bottom: 4px;
        padding-top: 24px;
        border-top: 1px solid var(--paper-line);
      }
      .shelf-count {
        font-size: 0.7rem;
      }
      .shelf-empty {
        margin: 24px 0 0;
        font-size: 0.76rem;
      }
      /* 底部按年份分组的轻量文字年表，不另起图表 */
      .shelf-years {
        margin-top: clamp(48px, 8vw, 80px);
        padding-top: 28px;
        border-top: 1px solid var(--paper-line);
      }
      .shelf-years-title {
        margin: 0 0 18px;
        color: var(--paper-ink-soft);
        font-family: var(--font-ui-label);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .shelf-year {
        margin-bottom: 22px;
      }
      .shelf-year-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 6px;
      }
      .shelf-year-name {
        color: var(--paper-ink);
        font-size: 1.05rem;
        font-weight: 600;
      }
      .shelf-year-count {
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
        font-size: 0.78rem;
      }
      .shelf-year-titles {
        margin: 0;
        color: var(--paper-ink-faint);
        font-family: var(--font-meta);
        font-size: 0.8rem;
        line-height: 1.85;
        max-width: 70ch;
      }
      @media (max-width: 760px) {
        main {
          padding-top: 98px;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main data-movie-shelf>
      <header class="shelf-hero">
        <div class="shelf-header-main">
          <p class="shelf-kicker">{kicker}</p>
          <h1 class="shelf-title">{pageMeta.title}</h1>
        </div>
        <div class="shelf-copy">
          <p class="shelf-subtitle">{pageMeta.subtitle}</p>
          <p class="shelf-note">{pageMeta.note}</p>
        </div>
      </header>
      <div class="shelf-heading">
        {
          summary ? (
            <span class="shelf-count">
              {summary.works} works · {Math.round(summary.totalMinutes / 60)} h · since{' '}
              {summary.sinceYear}
            </span>
          ) : (
            <span class="shelf-count">
              {items.length} {countLabel}
            </span>
          )
        }
      </div>
      {
        items.length ? (
          <MediaShelf variant={variant} columns={4} items={items} />
        ) : (
          <p class="shelf-empty">{empty}</p>
        )
      }
      {
        summary?.years?.length > 0 && (
          <section class="shelf-years" aria-label="By year">
            <h2 class="shelf-years-title">By year</h2>
            {summary.years.map((y) => (
              <div class="shelf-year">
                <div class="shelf-year-head">
                  <span class="shelf-year-name">{y.year}</span>
                  <span class="shelf-year-count">{y.titles.length}</span>
                </div>
                <p class="shelf-year-titles">{y.titles.join(' · ')}</p>
              </div>
            ))}
          </section>
        )
      }
    </main>
    <Footer />
  </body>
</html>
