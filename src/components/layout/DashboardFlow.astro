<main class="flow-shell" data-pagefind-body>
  <section class="flow-grid" aria-label="navfolio personal publication">
    <section class="flow-column main-column">
      <slot name="intro" />
      <slot name="doing" />
    </section>

    <aside class="flow-column side-column">
      <slot name="quote" />
      <slot name="navigation" />
      <slot name="connect" />
    </aside>
  </section>
</main>

<style>
  .flow-shell {
    width: min(100%, var(--layout-shell-width));
    margin: 0 auto;
    /* 首屏视觉平衡：整块内容在视口内垂直居中，避免所有元素挤在上半屏。
       内容高于视口时 min-height 自动失效，不会截断。 */
    min-height: calc(100dvh - 112px);
    display: grid;
    align-content: center;
    padding: 132px var(--layout-page-gutter) var(--layout-page-bottom);
  }

  .flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(260px, 300px);
    column-gap: 44px;
    row-gap: 0;
    justify-content: center;
    align-content: start;
  }

  /* 左栏拆开，让「标题」与「最新」各占一行 */
  .main-column {
    display: contents;
  }

  /* 右栏保持整体、作为一个网格项从第 2 行顶端开始，内部连续排列。
     若也拆成 display:contents，标语 / 导航 / 社交会各占一行，
     而行高由左栏那张很高的「最新」卡片决定 —— 导航卡就会被推到卡片
     底部之下，中间空出一大片。 */
  .side-column {
    display: flex;
    grid-column: 2;
    grid-row: 2;
    flex-direction: column;
    align-self: start;
    min-width: 0;
  }

  .flow-grid :global(.glass-card) {
    width: 100%;
  }

  /* —— 第 1 行：标题独占左栏，右栏留白，形成「左叙事 / 右索引」的起点 —— */
  .flow-grid :global(.intro-card) {
    grid-column: 1;
    grid-row: 1;
    min-height: 0;
    margin-bottom: 26px;
    padding: 0;
  }

  .flow-grid :global(.doing-stack) {
    grid-column: 1;
    grid-row: 2;
  }

  /* —— 右栏内部：标语 → 导航 → 社交，连续紧排 ——
     标语顶到右栏顶部（与「最新」卡片顶端齐平），下缘发丝线之下直接接导航卡。 */
  .flow-grid :global(.home-quote) {
    margin-bottom: 0;
  }

  .flow-grid :global(.nav-card) {
    margin-bottom: 6px;
  }

  .flow-grid :global(.connect-card) {
    padding: 6px 0 0;
  }

  @media (max-width: 920px) {
    .flow-grid {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
      column-gap: 34px;
    }
  }

  @media (max-width: 820px) {
    .flow-shell {
      min-height: 0;
      padding: 96px 18px 42px;
    }

    .flow-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* 移动端单列排列，右栏拆开逐项排序 */
    .side-column {
      display: contents;
    }

    /* 移动端顺序：标题 → 标语 → 最新 → 导航 → 社交 */
    .flow-grid :global(.intro-card) {
      order: 1;
      margin-bottom: 0;
    }

    .flow-grid :global(.home-quote) {
      order: 2;
      margin-bottom: 0;
      padding: 0 0 10px;
    }

    .flow-grid :global(.doing-stack) {
      order: 3;
    }

    .flow-grid :global(.nav-card) {
      order: 4;
      margin-bottom: 0;
      padding: 0;
    }

    .flow-grid :global(.connect-card) {
      order: 5;
      padding: 0;
    }
  }
</style>
