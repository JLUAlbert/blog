---
import { getSiteConfig } from '../../data/site';
import { canRenderProvider, getCommentProvider, resolveCommentsConfig } from '../../utils/comments';
import GiscusComment from './GiscusComment.astro';
import UtterancesComment from './UtterancesComment.astro';
import WalineComment from './WalineComment.astro';

interface Props {
  frontmatter: {
    comments?: boolean;
  };
  pathname: string;
}

const { frontmatter, pathname } = Astro.props;
const { comments: rawComments } = await getSiteConfig();
const comments = resolveCommentsConfig(rawComments);
const provider = frontmatter.comments === false ? null : getCommentProvider(comments);
const shouldRender = provider ? canRenderProvider(comments, provider) : false;
---

{
  shouldRender && provider && (
    <section class="comment-section" aria-label="Comments" data-comment-path={pathname}>
      <header class="comment-head">
        <div class="comment-head-title">
          <span class="comment-head-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.51 11.51 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.37.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .32.218.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </span>
          <h2>
            评论 <span class="comment-head-en">Comments</span>
          </h2>
        </div>
        <p class="comment-head-hint">
          使用 GitHub 账号登录后即可发表评论，内容保存在本仓库的 Discussions 中。
        </p>
      </header>

      <div class="comment-body">
        {provider === 'giscus' && <GiscusComment config={comments.giscus} />}
        {provider === 'utterances' && <UtterancesComment config={comments.utterances} />}
        {provider === 'waline' && <WalineComment config={comments.waline} />}
      </div>
    </section>
  )
}

<style>
  .comment-section {
    width: min(100%, var(--article-content-max, 720px));
    margin-top: 48px;
    padding: 30px 26px 26px;
    border: 1px solid var(--paper-line);
    border-radius: 18px;
    background: var(--paper-surface, #fffffc);
    box-shadow:
      0 18px 44px -26px rgba(20, 26, 22, 0.4),
      0 2px 8px -6px rgba(20, 26, 22, 0.25);
  }

  :global([data-theme='dark']) .comment-section {
    box-shadow:
      0 22px 50px -28px rgba(0, 0, 0, 0.7),
      0 2px 10px -6px rgba(0, 0, 0, 0.55);
  }

  .comment-head {
    display: grid;
    gap: 8px;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--paper-line);
  }

  .comment-head-title {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .comment-head-mark {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 5px;
    border-radius: 9px;
    color: #fff;
    background: var(--paper-accent, #4f855f);
    box-shadow: 0 4px 12px -6px color-mix(in srgb, var(--paper-accent, #4f855f) 70%, transparent);
  }

  .comment-head-title h2 {
    margin: 0;
    font-family: var(--font-meta);
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--paper-ink, #272d28);
  }

  .comment-head-en {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--paper-ink-faint, #899487);
    letter-spacing: 0.04em;
  }

  .comment-head-hint {
    margin: 0;
    font-family: var(--font-meta);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--paper-ink-soft, #667066);
  }

  .comment-body {
    min-height: 120px;
  }

  /* Giscus 等 iframe 容器：让边框与卡片协调 */
  .comment-body :global([data-comment-provider]) {
    overflow: hidden;
    border-radius: 12px;
  }

  :global(.blog-layout-centered .comment-section) {
    width: 100%;
  }

  @media (max-width: 560px) {
    .comment-section {
      padding: 24px 18px 20px;
      border-radius: 14px;
    }
  }
</style>
