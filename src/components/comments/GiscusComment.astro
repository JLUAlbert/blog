---
import type { CommentsConfig } from '../../utils/comments';

interface Props {
  config: CommentsConfig['giscus'];
}

const { config } = Astro.props;
// 两个部署平台的 base 不同（根路径 / 与 /blog），评论主题样式按当前页面
// 的 origin + BASE_URL 现场拼绝对地址，避免把主站域名写死在配置里。
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="comment-provider" data-comment-provider="giscus"></div>

<script type="module" define:vars={{ config, basePath }}>
  // 配置里以 '/' 开头的是本站样式文件路径；其余（含 http URL 与
  // transparent_dark 之类的内置主题名）原样交给 giscus。
  const resolveTheme = (theme) =>
    theme.startsWith('/') ? new URL(`${basePath}${theme}`, window.location.origin).href : theme;
  const lightTheme = resolveTheme(config.light_theme);
  const darkTheme = resolveTheme(config.dark_theme);

  const mountGiscus = () => {
    const container = document.querySelector('[data-comment-provider="giscus"]');

    if (!container) {
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('data-repo', config.repo);
    script.setAttribute('data-repo-id', config.repo_id);
    script.setAttribute('data-category', config.category);
    script.setAttribute('data-category-id', config.category_id);
    script.setAttribute('data-mapping', config.mapping);
    script.setAttribute('data-strict', config.strict);
    script.setAttribute('data-reactions-enabled', config.reactions_enabled);
    script.setAttribute('data-emit-metadata', config.emit_metadata);
    script.setAttribute('data-input-position', config.input_position);
    script.setAttribute(
      'data-theme',
      document.documentElement.dataset.theme === 'dark' ? darkTheme : lightTheme,
    );
    script.setAttribute('data-lang', config.lang);
    script.setAttribute('data-loading', config.loading);

    container.replaceChildren(script);
  };

  // TODO: Not sure if this event could cost some delay

  window.addEventListener('navfolio:theme-change', (event) => {
    const iframe = document.querySelector('iframe.giscus-frame');
    const siteTheme = event.detail?.theme === 'dark' ? 'dark' : 'light';

    iframe?.contentWindow?.postMessage(
      {
        giscus: {
          setConfig: {
            theme: siteTheme === 'dark' ? darkTheme : lightTheme,
          },
        },
      },
      'https://giscus.app',
    );
  });

  mountGiscus();
  document.addEventListener('astro:page-load', mountGiscus);
</script>
