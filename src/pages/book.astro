---
import { getCollection } from 'astro:content';
import ShelfPage from '../components/ShelfPage.astro';
import { getSiteConfig } from '../data/site';

const siteConfig = await getSiteConfig();
const pageMeta = siteConfig.pages.book;

const entries = (await getCollection('book', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.completedAt?.valueOf() ?? 0) - (a.data.completedAt?.valueOf() ?? 0)
);

function excerpt(text = '', maxLength = 120) {
  const plain = text
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/^#.*$/gm, '')
    .replace(/[#>*`_[\]()!]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > maxLength ? `${plain.slice(0, maxLength)}…` : plain;
}

const items = entries.map((entry) => ({
  title: entry.data.title,
  creator: entry.data.author,
  type: 'book' as const,
  cover: entry.data.cover,
  coverAspect: entry.data.coverAspect,
  reviewHref: `/book/${entry.id}/`,
  reviewLabel: 'Reading notes',
  note: excerpt(entry.body),
}));
---

<ShelfPage
  pageMeta={pageMeta}
  kicker="Reading shelf"
  variant="inline"
  countLabel="books"
  items={items}
  empty="The shelf is empty. Add a book under src/content/book/ and it will appear here."
/>
