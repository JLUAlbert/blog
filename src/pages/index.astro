---
import { getCollection, render } from 'astro:content';
import IntroCard from '../components/cards/IntroCard.astro';
import ConnectCard from '../components/cards/ConnectCard.astro';
import NavigationCard from '../components/cards/NavigationCard.astro';
import ProfileCard from '../components/cards/ProfileCard.astro';
import DashboardFlow from '../components/layout/DashboardFlow.astro';
import BlogHeatmap from '../components/widgets/BlogHeatmap.astro';
import RecentPosts from '../components/widgets/RecentPosts.astro';
import { getSiteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '@navfolio/theme-default/styles/blog-article.css';

const { home, profile, site } = await getSiteConfig();
const [aboutEntry] = await getCollection('about');
const { Content: AboutContent } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<BaseLayout title={site.pageTitle} description={site.pageDescription}>
  <div class="publication-bg" aria-hidden="true"></div>
  <DashboardFlow>
    <Fragment slot="profile">
      <ProfileCard profile={profile} />
    </Fragment>

    <Fragment slot="intro">
      <IntroCard intro={home.intro} quote={home.quote} />
    </Fragment>

    <Fragment slot="doing">
      <RecentPosts count={home.latest.count} excludeDraft={home.latest.excludeDraft} />
    </Fragment>

    <Fragment slot="latest">
      <BlogHeatmap
        weeks={home.latest.heatmapWeeks}
        showLatest={home.latest.showHeatmapLatest}
        latestCount={home.latest.count}
        excludeDraft={home.latest.excludeDraft}
        startDate={home.latest.startDate || null}
        dateArchiveBaseHref={home.latest.dateArchiveBaseHref || undefined}
      />
    </Fragment>

    <Fragment slot="navigation">
      <NavigationCard items={home.navigation} />
    </Fragment>

    <Fragment slot="connect">
      <ConnectCard links={home.links} />
    </Fragment>
  </DashboardFlow>

  {
    AboutContent && (
      <button class="about-hint" type="button" data-about-open aria-label="Open About">
        <span>About</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path>
        </svg>
      </button>
    )
  }

  {
    AboutContent && (
      <section id="about-panel" class="about-panel" aria-hidden="true" aria-label="About" inert>
        <div class="about-panel-scroll" data-about-scroll>
          <div class="about-panel-inner">
            <button class="about-close" type="button" data-about-close aria-label="Back to home">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path>
              </svg>
              <span>Home</span>
            </button>
            <article class="article-content about-content">
              <AboutContent />
            </article>
          </div>
        </div>
      </section>
    )
  }

</BaseLayout>

<style>
  .about-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px auto 64px;
    padding: 9px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-surface);
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .about-hint:hover,
  .about-hint:focus-visible {
    border-color: color-mix(in srgb, var(--paper-accent) 40%, transparent);
    color: var(--paper-accent);
    transform: translateY(2px);
  }

  .about-panel {
    position: fixed;
    inset: 0;
    z-index: 120;
    pointer-events: none;
    transform: translateY(100%);
    background: var(--paper-bg);
    box-shadow: none;
    transition:
      transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 760ms ease,
      background-color 300ms ease;
    will-change: transform;
  }

  .about-panel.is-open {
    pointer-events: auto;
    transform: translateY(0);
    box-shadow: 0 -22px 60px rgba(0, 0, 0, 0.16);
  }

  .about-panel-scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .about-panel-inner {
    max-width: 780px;
    margin: 0 auto;
    padding: 92px 30px 140px;
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 520ms ease 120ms,
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1) 80ms;
  }

  .about-panel.is-open .about-panel-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .about-content {
    --article-content-max: 780px;
  }

  .about-content h1:first-of-type {
    margin-top: 0;
  }

  .about-close {
    position: sticky;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 36px;
    padding: 8px 15px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-surface);
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }

  .about-close:hover,
  .about-close:focus-visible {
    border-color: color-mix(in srgb, var(--paper-accent) 45%, transparent);
    color: var(--paper-accent);
  }

  :global(html.about-open) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .about-panel-inner {
      padding: 72px 20px 110px;
    }

    .about-hint {
      margin-bottom: 44px;
    }
  }
</style>
