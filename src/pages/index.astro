---
import { getCollection, render } from 'astro:content';
import IntroCard from '../components/cards/IntroCard.astro';
import ConnectCard from '../components/cards/ConnectCard.astro';
import NavigationCard from '../components/cards/NavigationCard.astro';
import DashboardFlow from '../components/layout/DashboardFlow.astro';
import RecentPosts from '../components/widgets/RecentPosts.astro';
import UptimeBadge from '../components/widgets/UptimeBadge.astro';
import { getSiteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '@navfolio/theme-default/styles/blog-article.css';

const { home, site } = await getSiteConfig();
const [aboutEntry] = await getCollection('about');
const { Content: AboutContent } = aboutEntry ? await render(aboutEntry) : { Content: null };

// 首页导航卡上的内容计数：Blog / Vibe / Movies 的非草稿条目数
const [blogPosts, vibePosts, moviePosts] = await Promise.all([
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('vibe', ({ data }) => !data.draft),
  getCollection('movie', ({ data }) => !data.draft),
]);
const navCounts: Record<string, number> = {
  '/blog': blogPosts.length,
  '/vibe': vibePosts.length,
  '/movie': moviePosts.length,
};
---

<BaseLayout title={site.pageTitle} description={site.pageDescription}>
  <div class="publication-bg" aria-hidden="true"></div>
  <DashboardFlow>
    <Fragment slot="intro">
      <IntroCard intro={home.intro} />
    </Fragment>

    <Fragment slot="doing">
      <div class="doing-stack">
        <RecentPosts count={home.latest.count} excludeDraft={home.latest.excludeDraft} />
      </div>
    </Fragment>

    <Fragment slot="quote">
      {
        home.quote && (
          <blockquote class="home-quote blur-in">
            <span>- {home.quote.text.slice(0, 2).join(' ')}</span>
            <span>{home.quote.text.slice(2).join(' ')}</span>
          </blockquote>
        )
      }
    </Fragment>

    <Fragment slot="navigation">
      <NavigationCard items={home.navigation} counts={navCounts} />
    </Fragment>

    <Fragment slot="connect">
      <ConnectCard links={home.links}>
        <UptimeBadge slot="aside" />
      </ConnectCard>
    </Fragment>
  </DashboardFlow>

  {
    AboutContent && (
      <button class="about-hint" type="button" data-about-open aria-label="Open About">
        <span>About</span>
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <>
            <path d="M12 5v14" />
            <path d="m19 12-7 7-7-7" />
          </>
        </svg>
      </button>
    )
  }

  {
    AboutContent && (
      <section id="about-panel" class="about-panel" aria-hidden="true" aria-label="About" inert>
        <div class="about-panel-scroll" data-about-scroll>
          <div class="about-panel-inner">
            <button class="about-close" type="button" data-about-close aria-label="Back to home">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <>
                  <path d="M12 19V5" />
                  <path d="m5 12 7-7 7 7" />
                </>
              </svg>
              <span>Home</span>
            </button>
            <article class="article-content about-content">
              <AboutContent />
              <div class="about-footer-note">© 2026 Albert's Blog. © 2026 Albert Chan</div>
            </article>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* 左栏第二个网格项：内部只有一个「最新」卡片，占位用 */
  .doing-stack {
    display: grid;
    gap: 0;
  }

  /* 右栏顶部标语：斜体衬线小宣言，下缘一条发丝分隔线与导航区隔开 */
  .home-quote {
    display: grid;
    gap: 2px;
    margin: 0;
    /* 下缘仅留一条发丝线的呼吸位，与下方导航卡紧密排列 */
    padding: 0 0 10px;
    border: 0;
    border-bottom: 1px solid var(--paper-line);
    color: var(--paper-ink-soft);
    font-family: var(--font-note);
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.72;
  }

  .home-quote span {
    display: block;
  }

  /* About 面板末尾的版权栏：容器化，与全局页脚风格一致 */
  .about-footer-note {
    display: block;
    margin: 48px 0 8px;
    padding: 14px 20px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-control);
    color: var(--paper-ink-faint);
    font-size: 0.86rem;
    text-align: center;
    line-height: 1.6;
  }

  .about-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px auto 64px;
    padding: 9px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-surface);
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .about-hint:hover,
  .about-hint:focus-visible {
    border-color: color-mix(in srgb, var(--paper-accent) 40%, transparent);
    color: var(--paper-accent);
    transform: translateY(2px);
  }

  .about-panel {
    position: fixed;
    inset: 0;
    z-index: 120;
    pointer-events: none;
    transform: translateY(100%);
    background: var(--paper-bg);
    box-shadow: none;
    transition:
      transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 760ms ease,
      background-color 300ms ease;
    will-change: transform;
  }

  .about-panel.is-open {
    pointer-events: auto;
    transform: translateY(0);
    box-shadow: 0 -22px 60px rgba(0, 0, 0, 0.16);
  }

  .about-panel-scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .about-panel-inner {
    max-width: 780px;
    margin: 0 auto;
    padding: 92px 30px 140px;
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 520ms ease 120ms,
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1) 80ms;
  }

  .about-panel.is-open .about-panel-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .about-content {
    --article-content-max: 780px;
  }

  .about-content h1:first-of-type {
    margin-top: 0;
  }

  .about-close {
    position: sticky;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 36px;
    padding: 8px 15px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-surface);
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }

  .about-close:hover,
  .about-close:focus-visible {
    border-color: color-mix(in srgb, var(--paper-accent) 45%, transparent);
    color: var(--paper-accent);
  }

  :global(html.about-open) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .about-panel-inner {
      padding: 72px 20px 110px;
    }

    .about-hint {
      margin-bottom: 44px;
    }
  }
</style>
