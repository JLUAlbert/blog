---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogArticle from '../../layouts/BlogArticle.astro';
import ZoomableImage from '@navfolio/mdx-components/ZoomableImage.astro';

export async function getStaticPaths() {
  const books = await getCollection('book', ({ data }) => !data.draft);
  return books.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'book'> };

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const finished = entry.data.completedAt
  ? new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      entry.data.completedAt,
    )
  : undefined;

const meta = [
  entry.data.author,
  entry.data.publisher,
  entry.data.year ? String(entry.data.year) : undefined,
  finished ? `Finished ${finished}` : undefined,
]
  .filter(Boolean)
  .join(' · ');

const plain = (entry.body ?? '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/^#.*$/gm, '')
  .replace(/[#>*`_[\]()!]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const description = plain.length > 140 ? `${plain.slice(0, 140)}…` : plain;

const pseudoPost = {
  id: entry.id,
  collection: 'book',
  body: entry.body,
  data: {
    title: entry.data.title,
    description,
    date: entry.data.completedAt ?? new Date(),
    heroImage: undefined,
    showHeroImage: false,
    tags: entry.data.tags ?? [],
    categories: [],
    series: [],
    draft: false,
    sidebar: { enable: false, toc: false, relatedPosts: false },
  },
};
---

<BlogArticle
  post={pseudoPost}
  headings={headings}
  headerVariant="archive"
  headerKicker="Book Notes"
  headerNote={meta}
>
  <Content components={{ img: ZoomableImage }} />
</BlogArticle>
