---
import ThemeBaseLayout from '@navfolio/theme-default/components/BaseLayout.astro';
import BaseHead from '../components/BaseHead.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import FullFontWarmup from '../components/FullFontWarmup.astro';
import ScrollToTopButton from '../components/ScrollToTopButton.astro';
import { getSiteConfig } from '../data/site';
import { getHtmlLang } from '../utils/ui-text';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteConfig = await getSiteConfig();
const palette = siteConfig.theme.palette;
const htmlLang = getHtmlLang(siteConfig);
---

<ThemeBaseLayout htmlLang={htmlLang} palette={palette}>
  <Fragment slot="head">
    <BaseHead title={title} description={description} />
  </Fragment>
  <Fragment slot="navigation">
    <BlogTopNav />
  </Fragment>
  <slot />
  <Fragment slot="after-content">
    <ScrollToTopButton />
    <FullFontWarmup />
  </Fragment>
</ThemeBaseLayout>

<script>
  // About 面板控制器：全站加载一次，仅当页面存在 #about-panel（首页）时生效。
  // 站点启用了 ClientRouter，<script is:inline> 在客户端导航后不会重新执行，
  // 因此把逻辑放在布局层，并借助 astro:page-load 在每次导航后复位状态。
  (() => {
    const PANEL_ID = 'about-panel';
    const root = document.documentElement;
    const host = window as Window & { __aboutPanelController?: boolean };
    const state = { open: false, locked: false, timer: 0 };

    const panel = () => document.getElementById(PANEL_ID);
    const scroller = () => panel()?.querySelector<HTMLElement>('[data-about-scroll]') ?? null;

    const lock = () => {
      state.locked = true;
      window.clearTimeout(state.timer);
      state.timer = window.setTimeout(() => {
        state.locked = false;
      }, 760);
    };

    const applyState = (open: boolean) => {
      const element = panel();
      state.open = open && Boolean(element);
      if (element) {
        element.classList.toggle('is-open', state.open);
        element.setAttribute('aria-hidden', state.open ? 'false' : 'true');
        if (state.open) element.removeAttribute('inert');
        else element.setAttribute('inert', '');
      }
      root.classList.toggle('about-open', state.open);
      if (state.open) {
        const target = scroller();
        if (target) target.scrollTop = 0;
      }
    };

    const openPanel = () => {
      if (!panel() || state.open) return;
      lock();
      applyState(true);
    };

    const closePanel = () => {
      if (!state.open) return;
      lock();
      applyState(false);
    };

    const atPageBottom = () => window.innerHeight + window.scrollY >= root.scrollHeight - 8;

    if (!host.__aboutPanelController) {
      host.__aboutPanelController = true;

      // 触控板 / 滚轮：页面触底后继续下滑 → 打开 About；面板顶部继续上滑 → 回到首页
      window.addEventListener(
        'wheel',
        (event) => {
          if (state.locked || !panel()) return;
          if (!state.open) {
            if (event.deltaY > 8 && atPageBottom()) {
              event.preventDefault();
              openPanel();
            }
            return;
          }
          const target = scroller();
          if (event.deltaY < -8 && target && target.scrollTop <= 0) {
            event.preventDefault();
            closePanel();
          }
        },
        { passive: false },
      );

      // 移动端触摸：上滑打开、下滑关闭
      let touchStartY = 0;
      window.addEventListener(
        'touchstart',
        (event) => {
          touchStartY = event.touches[0]?.clientY ?? 0;
        },
        { passive: true },
      );
      window.addEventListener(
        'touchmove',
        (event) => {
          if (state.locked || !panel()) return;
          const delta = touchStartY - (event.touches[0]?.clientY ?? 0);
          if (!state.open) {
            if (delta > 46 && atPageBottom()) openPanel();
            return;
          }
          const target = scroller();
          if (delta < -46 && target && target.scrollTop <= 0) closePanel();
        },
        { passive: true },
      );

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        if (!target?.closest) return;
        if (target.closest('[data-about-open]')) {
          event.preventDefault();
          openPanel();
          return;
        }
        if (target.closest('[data-about-close]')) {
          event.preventDefault();
          closePanel();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && state.open) closePanel();
      });
    }

    // 初始加载与每次客户端导航后复位，避免离开首页时残留滚动锁。
    const reset = () => {
      state.locked = false;
      window.clearTimeout(state.timer);
      applyState(false);
    };

    document.addEventListener('astro:page-load', reset);
    reset();
  })();
</script>

<script>
  // 导航过渡控制器 —— iOS 风格的分层切换（pan / zoom / aurora）
  (() => {
    const root = document.documentElement;
    // 顶层导航页顺序，用于判断平移方向
    const NAV_ORDER = ['/', '/blog', '/vibe', '/movie'];
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const norm = (p) => p.replace(/\/+$/, '') || '/';
    const isArticle = (p) => /^\/(blog|vibe)\/[^/]+$/.test(p);
    const topIndex = (p) => NAV_ORDER.indexOf(p);

    const internalTarget = (a) => {
      if (!a || a.target === '_blank' || a.hasAttribute('download')) return null;
      if (a.origin !== location.origin) return null;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin) return null;
      if (url.hash && norm(url.pathname) === norm(location.pathname)) return null;
      return url;
    };

    const setMode = (mode, detail, x, y) => {
      root.setAttribute('data-vt', mode);
      if (detail != null) root.setAttribute('data-vt-detail', String(detail));
      else root.removeAttribute('data-vt-detail');
      if (x != null) {
        root.style.setProperty('--vt-x', x + '%');
        root.style.setProperty('--vt-y', y + '%');
      }
    };
    const clearMode = () => {
      root.removeAttribute('data-vt');
      root.removeAttribute('data-vt-detail');
      root.style.removeProperty('--vt-x');
      root.style.removeProperty('--vt-y');
    };

    const ensureAurora = () => {
      let el = document.querySelector('.site-aurora');
      if (!el) {
        el = document.createElement('div');
        el.className = 'site-aurora';
        el.setAttribute('aria-hidden', 'true');
        el.innerHTML =
          '<div class="site-aurora-bg"></div>' +
          '<div class="site-aurora-brand">Albert\'s Blog<span class="dot">.</span></div>';
        document.body.appendChild(el);
      }
      return el;
    };
    const playAurora = () => {
      if (REDUCED) return;
      const el = ensureAurora();
      el.classList.remove('play', 'cover');
      void el.offsetWidth;
      el.classList.add('play');
    };

    let firstLoad = true;

    if (!REDUCED) {
      // 捕获阶段先于 Astro 的 ClientRouter 点击监听，确保快照前已设定过渡模式
      document.addEventListener(
        'click',
        (e) => {
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          )
            return;
          const a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          const url = internalTarget(a);
          if (!url) return;

          const dest = norm(url.pathname);
          const from = norm(location.pathname);
          const fromArticle = isArticle(from);
          const toArticle = isArticle(dest);
          const fromTop = topIndex(from) >= 0;
          const toTop = topIndex(dest) >= 0;

          if (toArticle && !toTop) {
            // 点进文章：由触点放大至全屏
            const x = Math.round((e.clientX / window.innerWidth) * 100);
            const y = Math.round((e.clientY / window.innerHeight) * 100);
            setMode('zoom', null, x, y);
          } else if (fromArticle && toTop) {
            // 从文章返回首页 / 导航页：极光揭幕（先遮住旧页，切换更顺）
            setMode('aurora');
            ensureAurora().classList.add('cover');
          } else if (toTop && fromTop) {
            // 导航栏页面之间：左右平移
            const dir = topIndex(dest) >= topIndex(from) ? 'right' : 'left';
            setMode('pan', dir);
          } else {
            // 其它：克制淡入淡出
            setMode('cross');
          }
        },
        true,
      );
    }

    document.addEventListener('astro:page-load', () => {
      const mode = root.getAttribute('data-vt');
      if (mode === 'aurora' || firstLoad) playAurora();
      firstLoad = false;
      clearMode();
    });
  })();
</script>
