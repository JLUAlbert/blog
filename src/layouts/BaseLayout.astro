---
import ThemeBaseLayout from '@navfolio/theme-default/components/BaseLayout.astro';
import BaseHead from '../components/BaseHead.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import FullFontWarmup from '../components/FullFontWarmup.astro';
import ScrollToTopButton from '../components/ScrollToTopButton.astro';
import { getSiteConfig } from '../data/site';
import { getHtmlLang } from '../utils/ui-text';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteConfig = await getSiteConfig();
const palette = siteConfig.theme.palette;
const htmlLang = getHtmlLang(siteConfig);
---

<ThemeBaseLayout htmlLang={htmlLang} palette={palette}>
  <Fragment slot="head">
    <BaseHead title={title} description={description} />
  </Fragment>
  <Fragment slot="navigation">
    <BlogTopNav />
  </Fragment>
  <slot />
  <Fragment slot="after-content">
    <ScrollToTopButton />
    <FullFontWarmup />
  </Fragment>
</ThemeBaseLayout>

<script>
  // About 面板控制器：全站加载一次，仅当页面存在 #about-panel（首页）时生效。
  // 站点启用了 ClientRouter，<script is:inline> 在客户端导航后不会重新执行，
  // 因此把逻辑放在布局层，并借助 astro:page-load 在每次导航后复位状态。
  (() => {
    const PANEL_ID = 'about-panel';
    const root = document.documentElement;
    const host = window as Window & { __aboutPanelController?: boolean };
    const state = { open: false, locked: false, timer: 0 };

    const panel = () => document.getElementById(PANEL_ID);
    const scroller = () => panel()?.querySelector<HTMLElement>('[data-about-scroll]') ?? null;

    const lock = () => {
      state.locked = true;
      window.clearTimeout(state.timer);
      state.timer = window.setTimeout(() => {
        state.locked = false;
      }, 760);
    };

    const applyState = (open: boolean) => {
      const element = panel();
      state.open = open && Boolean(element);
      if (element) {
        element.classList.toggle('is-open', state.open);
        element.setAttribute('aria-hidden', state.open ? 'false' : 'true');
        if (state.open) element.removeAttribute('inert');
        else element.setAttribute('inert', '');
      }
      root.classList.toggle('about-open', state.open);
      if (state.open) {
        const target = scroller();
        if (target) target.scrollTop = 0;
      }
    };

    const openPanel = () => {
      if (!panel() || state.open) return;
      lock();
      applyState(true);
    };

    const closePanel = () => {
      if (!state.open) return;
      lock();
      applyState(false);
    };

    const atPageBottom = () => window.innerHeight + window.scrollY >= root.scrollHeight - 8;

    if (!host.__aboutPanelController) {
      host.__aboutPanelController = true;

      // 触控板 / 滚轮：页面触底后继续下滑 → 打开 About；面板顶部继续上滑 → 回到首页
      window.addEventListener(
        'wheel',
        (event) => {
          if (state.locked || !panel()) return;
          if (!state.open) {
            if (event.deltaY > 8 && atPageBottom()) {
              event.preventDefault();
              openPanel();
            }
            return;
          }
          const target = scroller();
          if (event.deltaY < -8 && target && target.scrollTop <= 0) {
            event.preventDefault();
            closePanel();
          }
        },
        { passive: false },
      );

      // 移动端触摸：上滑打开、下滑关闭
      let touchStartY = 0;
      window.addEventListener(
        'touchstart',
        (event) => {
          touchStartY = event.touches[0]?.clientY ?? 0;
        },
        { passive: true },
      );
      window.addEventListener(
        'touchmove',
        (event) => {
          if (state.locked || !panel()) return;
          const delta = touchStartY - (event.touches[0]?.clientY ?? 0);
          if (!state.open) {
            if (delta > 46 && atPageBottom()) openPanel();
            return;
          }
          const target = scroller();
          if (delta < -46 && target && target.scrollTop <= 0) closePanel();
        },
        { passive: true },
      );

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        if (!target?.closest) return;
        if (target.closest('[data-about-open]')) {
          event.preventDefault();
          openPanel();
          return;
        }
        if (target.closest('[data-about-close]')) {
          event.preventDefault();
          closePanel();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && state.open) closePanel();
      });
    }

    // 初始加载与每次客户端导航后复位，避免离开首页时残留滚动锁。
    const reset = () => {
      state.locked = false;
      window.clearTimeout(state.timer);
      applyState(false);
    };

    document.addEventListener('astro:page-load', reset);
    reset();
  })();
</script>

<script>
  // Paper Motion：仅在客户端导航后为 <html> 标记 client-nav，
  // 文章页的错峰浮起动画借此区分「站内切换」与「直接打开」（后者不播放入场）。
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.add('client-nav');
  });
</script>

<script>
  // ===== 动效驱动（源自 web-motion-showcase，克制、可复用、reduced-motion 安全）=====
  // 统一在每次页面加载（含客户端导航）后初始化；幕布转场挂在视图转场事件上。
  const motionReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- 滑动指示器药丸 ---------- */
  let tabResizeBound = false;
  let tabFirstInit = false;
  let tabLast: { w: number; x: number } | null = null;
  function initSlidingTabs() {
    const nav = document.querySelector('.nav-links');
    if (!nav) return;
    const pill = nav.querySelector('.tab-pill');
    if (!pill) return;
    const active = nav.querySelector('.nav-link.active');
    if (!active) {
      pill.style.width = '0px';
      return;
    }
    const w = active.offsetWidth;
    const x = active.offsetLeft;
    const placeInstant = () => {
      pill.style.transition = 'none';
      pill.style.width = `${w}px`;
      pill.style.transform = `translateX(${x}px)`;
      void pill.offsetHeight;
      pill.style.transition = '';
    };
    if (!tabFirstInit) {
      placeInstant();
      tabFirstInit = true;
    } else if (tabLast) {
      const last = tabLast;
      pill.style.transition = 'none';
      pill.style.width = `${last.w}px`;
      pill.style.transform = `translateX(${last.x}px)`;
      void pill.offsetHeight;
      pill.style.transition = '';
      pill.style.width = `${w}px`;
      pill.style.transform = `translateX(${x}px)`;
    } else {
      placeInstant();
    }
    tabLast = { w, x };

    if (!tabResizeBound) {
      tabResizeBound = true;
      let t = 0;
      window.addEventListener('resize', () => {
        clearTimeout(t);
        t = window.setTimeout(() => {
          const a = nav.querySelector('.nav-link.active');
          if (!a) return;
          pill.style.width = `${a.offsetWidth}px`;
          pill.style.transform = `translateX(${a.offsetLeft}px)`;
        }, 120);
      });
    }
  }

  /* ---------- 数字滚动（博客运行时间）---------- */
  function initCountUp() {
    const root = document.querySelector('[data-uptime]');
    if (!root) return;
    const start = new Date(root.dataset.start).getTime();
    if (Number.isNaN(start)) return;
    const nums = Array.from(root.querySelectorAll('.uptime-num'));
    if (!nums.length) return;

    const compute = () => {
      const diff = Math.max(0, Date.now() - start);
      const s = Math.floor(diff / 1000);
      return {
        days: Math.floor(s / 86400),
        hours: Math.floor((s % 86400) / 3600),
        mins: Math.floor((s % 3600) / 60),
        secs: s % 60,
      };
    };
    const setVals = (v) => {
      nums.forEach((el) => {
        const u = el.dataset.unit;
        const n = Math.floor(v[u] || 0);
        el.textContent = u === 'days' ? String(n) : String(n).padStart(2, '0');
      });
    };

    if (motionReduced()) {
      setVals(compute());
      window.setInterval(() => setVals(compute()), 1000);
      return;
    }

    let started = false;
    const runCountUp = () => {
      if (started) return;
      started = true;
      const target = compute();
      const duration = 1500;
      const t0 = performance.now();
      const tick = () => {
        const p = Math.min(1, (performance.now() - t0) / duration);
        const e = 1 - Math.pow(1 - p, 3);
        setVals({
          days: target.days * e,
          hours: target.hours * e,
          mins: target.mins * e,
          secs: target.secs * e,
        });
        if (p < 1) requestAnimationFrame(tick);
        else {
          setVals(target);
          window.setInterval(() => setVals(compute()), 1000);
        }
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            runCountUp();
            io.disconnect();
          }
        });
      },
      { threshold: 0.2 },
    );
    io.observe(root);
  }

  /* ---------- 文字逐行显现：已移除（原作用于文章正文 h2/h3）---------- */
  /* 改为 Vibe 页「逐项遮罩上移」：见 BlogTopNav 的 initVibeMaskUp。 */

  function initMotion() {
    initSlidingTabs();
    initCountUp();
  }

  document.addEventListener('astro:page-load', initMotion);
</script>
